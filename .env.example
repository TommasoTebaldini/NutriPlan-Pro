# Copia questo file in .env (locale, MAI committato) e compila i valori.
# Due destinazioni diverse:
#  - variabili "Vercel"   → Project Settings > Environment Variables (usate da api/*.js e da js/utils.js lato server)
#  - variabili "Supabase" → supabase secrets set NOME=valore (usate dalle Edge Function in supabase/functions/)
# Il client (js/utils.js) usa URL/publishable key hardcoded, sono pubblici per design — non servono qui.

# ── Supabase (Vercel + Edge Function) ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SB_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SB_SECRET_KEY=

# ── AI (fallback Gemini -> Groq -> Claude, basta una chiave per funzionare) ─
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── Stripe (SETUP-STRIPE.md — non attivo finché PAYMENTS_ACTIVE=false) ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PATIENT_PRICE_MONTHLY=

# ── RevenueCat (abbonamento Pro nativo iOS/Android) ─────────────────────────
REVENUECAT_WEBHOOK_AUTH=

# ── Email/notifiche ──────────────────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── FSE/FHIR gateway ─────────────────────────────────────────────────────────
FSE_GATEWAY_URL=
FSE_GATEWAY_TOKEN=

# ── Fatturazione elettronica (STS) ───────────────────────────────────────────
STS_API_BASE=

# ── Google Calendar sync ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
CALENDAR_SECRET=

# ── Cron/cache/rate-limit ────────────────────────────────────────────────────
CRON_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Varie ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=
PATIENT_APP_URL=https://your-patient-app.vercel.app
