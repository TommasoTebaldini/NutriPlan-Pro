{
  "name": "nutriplan-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "vite build",
    "build:vite": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
